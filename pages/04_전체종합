# ── 최종 결론 ────────────────────────────────────────────────────────────────
st.subheader("📝 최종 결론 및 시사점")

x1 = df["건물밀집도"].values
x2 = df["녹지율"].values
y_temp = df["평균기온"].values
y_wind = df["평균풍속"].values

r1 = np.corrcoef(x1, y_temp)[0, 1]
r2 = np.corrcoef(x1, y_wind)[0, 1]
r3 = np.corrcoef(x2, y_temp)[0, 1]

def judge(r, positive=True):
    if positive:
        return "✅ 지지됨" if r > 0.3 else "❌ 지지되지 않음"
    else:
        return "✅ 지지됨" if r < -0.3 else "❌ 지지되지 않음"

