])

def scatter_with_trendline(x_col, y_col, x_label, y_label, title):
    fig = go.Figure()
    for _, row in df.iterrows():
        fig.add_trace(go.Scatter(
            x=[row[x_col]], y=[row[y_col]],
            mode="markers+text",
            name=row["지역"],
            text=[row["지역"]],
            textposition="top center",
            marker=dict(size=16, color=CITY_COLORS[row["지역"]]),
            showlegend=True,
        ))
    # 추세선
    x_vals = df[x_col].values
    y_vals = df[y_col].values
    m, b = np.polyfit(x_vals, y_vals, 1)
    x_line = np.linspace(x_vals.min(), x_vals.max(), 100)
    y_line = m * x_line + b
    corr = np.corrcoef(x_vals, y_vals)[0, 1]
    fig.add_trace(go.Scatter(
        x=x_line, y=y_line,
        mode="lines",
        name=f"추세선 (r={corr:.2f})",
        line=dict(color="gray", dash="dash", width=2),
        showlegend=True,
    ))
    fig.update_layout(
        title=f"{title} (상관계수 r = {corr:.2f})",
        xaxis_title=x_label,
        yaxis_title=y_label,
        height=480,
        legend=dict(orientation="v", x=1.01, y=1),
    )
    return fig, corr

with tab_a:
    fig, corr = scatter_with_trendline("건물밀집도", "평균기온",
                                       "건물밀집도 (개/km²)", "평균기온 (°C)",
                                       "건물밀집도 vs 평균기온")
    st.plotly_chart(fig, use_container_width=True)
    direction = "양의" if corr > 0 else "음의"
    strength = "강한" if abs(corr) > 0.7 else ("보통의" if abs(corr) > 0.4 else "약한")
    verdict = "✅ 가설 지지" if corr > 0.3 else "❌ 가설 불지지"
